{
  "name": "smart-presale-oss-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node -e \"console.error('Destructive seed is blocked. Use npm run db:seed:reset only when you intentionally want to reset local demo data.'); process.exit(1)\"",
    "db:seed:reset": "node --env-file=.env --import tsx prisma/seed.ts --confirm-destructive-seed",
    "db:push": "prisma db push",
    "db:health": "node --env-file=.env --import tsx src/import/cli/check-operational-db.ts",
    "db:enforce-open-action-invariant": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/0006_sales_action_open_invariant/migration.sql",
    "db:repair-open-action-conflicts": "node --env-file=.env --import tsx src/import/cli/repair-open-sales-action-conflicts.ts",
    "verify:manager-runtime": "node --env-file=.env --import tsx src/import/cli/verify-manager-workspace-runtime.ts",
    "verify:p1a-exit-gate": "node --env-file=.env --import tsx src/import/cli/verify-p1a-exit-gate.ts",
    "demo:reset": "node --env-file=.env --import tsx src/import/cli/demo-readiness.ts reset",
    "demo:seed": "node --env-file=.env --import tsx src/import/cli/demo-readiness.ts seed",
    "demo:verify": "node --env-file=.env --import tsx src/import/cli/demo-readiness.ts verify",
    "verify:3d-visual-confidence": "node --env-file=.env --import tsx src/import/cli/verify-3d-visual-confidence.ts",
    "import:demo": "node --env-file=.env --import tsx src/import/cli/import-demo.ts",
    "backfill:operational": "node --env-file=.env --import tsx src/import/cli/backfill-operational-core.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.7.0",
    "@react-pdf/renderer": "^4.3.1",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.5.0",
    "iconv-lite": "^0.7.0",
    "lucide-react": "^0.544.0",
    "next": "^16.2.1",
    "pino": "^9.9.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.3.1",
    "three": "^0.180.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.2.1",
    "jsdom": "^27.0.1",
    "pino-pretty": "^13.1.2",
    "postcss": "^8.5.6",
    "prisma": "^6.7.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
