# Smart Presale OSS Toolkit local demo configuration

# Use a local development database only. Do not put production credentials here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_presale_oss?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# true keeps the app on demo/generated read models where supported.
DEMO_DATA_ONLY="true"

# Destructive seed/reset commands are blocked unless explicitly confirmed.
ALLOW_DESTRUCTIVE_SEED="false"

# Optional import sources for local experiments.
# Keep these empty in public commits. Use local absolute paths only in your private .env.
IMPORT_BITRIX_CSV_PATH=""
IMPORT_PRICE_OPTIMUM_XLSX_PATH=""
IMPORT_PRICE_PREMIUM_XLSX_PATH=""
IMPORT_KP_SAMPLE_XLSX_PATH=""
IMPORT_MATERIAL_COSTS_XLSX_PATH=""
IMPORT_3D_ROOT_PATH=""
IMPORT_DWG_ROOT_PATH=""

# Optional local overrides for demo request storage.
CLIENT_REQUESTS_DATA_PATH=""
CLIENT_REQUEST_UPLOADS_DIR=""
